# Healthcare Appointment Slot Optimizer — Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# --- Server ---
HOST=0.0.0.0
PORT=8000
ENV=development
API_KEYS=dev-key-1,dev-key-2

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:devpass@localhost:5434/scheduler

# --- Scheduling ---
SLOT_INCREMENT_MINUTES=15
DEFAULT_BUFFER_MINUTES=10
MAX_DAILY_APPOINTMENTS=20
OVERBOOK_DEFAULT=0

# --- Logging ---
LOG_LEVEL=info
