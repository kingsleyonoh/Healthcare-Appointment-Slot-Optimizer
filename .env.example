# Healthcare Appointment Slot Optimizer — Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# --- Application ---
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql://haso_user:haso_dev_pass@localhost:5432/haso_dev

# --- Authentication ---
API_KEY=changeme-generate-a-real-key

# --- Optimizer ---
DEFAULT_SLOT_DURATION_MIN=30
DEFAULT_BUFFER_MIN=10

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
